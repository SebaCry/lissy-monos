---
import { Icon } from 'astro-icon/components';
import { marca, enlaces, whatsapp, tonoPorCodigo } from '../data/site';

/* El moño del hero toma el color del tono elegido abajo.
   Es la promesa de la marca hecha interacción: "escríbeme y te envío
   todos nuestros colores disponibles" — aquí los ves de una vez. */

const tonosHero = [
  'LM-03', // Rosado
  'LM-05', // Lila aperlado super claro
  'LM-06', // Azul celeste
  'LM-07', // Verde pastel
  'LM-04', // Rosado quemado
  'LM-08', // Terracota claro
  'LM-10', // Rojo
  'LM-11', // Negro
].map(tonoPorCodigo);

const ctaPedido = whatsapp(
  `Hola ${marca.nombre} 🎀 Vi la página y me interesan sus accesorios. ¿Me cuentas colores y precios?`,
);
---

<section
  id="inicio"
  class="papel relative overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24"
  data-hero
  style={`--tono:${tonosHero[0].hex};--tono-2:${tonoPorCodigo('LM-02').hex}`}
>
  <!-- Halo ambiental que se retiñe con el tono elegido -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 transition-[background] duration-700"
    style="background: radial-gradient(60% 55% at 72% 28%, color-mix(in oklab, var(--tono) 26%, transparent) 0%, transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 lg:grid-cols-[1.05fr_1fr] lg:gap-8 lg:px-10">
    <!-- Texto -->
    <div class="relative">
      <p class="eyebrow animate__animated animate__fadeIn">
        {marca.ciudad} · {marca.departamento} · {marca.pais}
      </p>

      <h1 class="animate__animated animate__fadeInUp mt-5 text-[clamp(2.9rem,8vw,5.2rem)]">
        Aquí empieza tu<br />
        <span class="relative inline-block">
          mood bonito
          <!-- Subrayado de cinta: se dibuja al cargar -->
          <svg
            class="absolute -bottom-2 left-0 h-[0.42em] w-full text-rosa"
            viewBox="0 0 300 22"
            fill="none"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M3 15C58 5 98 18 148 11C198 4 246 16 297 7"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
              pathLength="1"
              class="[stroke-dasharray:1] [stroke-dashoffset:1] motion-safe:[animation:trazo_1.2s_var(--ease-cinta)_.7s_forwards] motion-reduce:[stroke-dashoffset:0]"
            ></path>
          </svg>
        </span>
      </h1>

      <p
        class="animate__animated animate__fadeInUp mt-8 max-w-lg text-lg text-tinta-suave"
        style="animation-delay:.18s"
      >
        Moños, scrunchies y cosmetiqueras hechos a mano en {marca.ciudad}. Materiales que no destiñen,
        elásticos que no ceden y un color para cada mood. Al detal y al por mayor.
      </p>

      <div
        class="animate__animated animate__fadeInUp mt-9 flex flex-wrap items-center gap-3"
        style="animation-delay:.3s"
      >
        <a
          href={ctaPedido}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2.5 rounded-full bg-rosa-hondo px-7 py-4 font-medium text-white shadow-alto transition hover:-translate-y-0.5 hover:bg-tinta"
        >
          <Icon name="simple-icons:whatsapp" class="h-5 w-5" aria-hidden="true" />
          Pedir por WhatsApp
        </a>
        <a
          href={enlaces.catalogoDetal}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 rounded-full border border-tinta/15 px-7 py-4 font-medium text-tinta transition hover:border-rosa hover:bg-white/60"
        >
          <Icon name="ph:book-open-duotone" class="h-5 w-5" aria-hidden="true" />
          Ver el catálogo
        </a>
      </div>

      <ul
        class="animate__animated animate__fadeIn mt-10 flex flex-wrap gap-x-7 gap-y-2 font-mono text-[0.7rem] tracking-[0.14em] text-tinta-suave uppercase"
        style="animation-delay:.5s"
      >
        <li class="flex items-center gap-2">
          <Icon name="ph:scissors-duotone" class="h-4 w-4 text-rosa" aria-hidden="true" /> Hecho a mano
        </li>
        <li class="flex items-center gap-2">
          <Icon name="ph:package-duotone" class="h-4 w-4 text-rosa" aria-hidden="true" /> Envíos a toda Colombia
        </li>
        <li class="flex items-center gap-2">
          <Icon name="ph:tag-duotone" class="h-4 w-4 text-rosa" aria-hidden="true" /> Mayor y detal
        </li>
      </ul>
    </div>

    <!-- Moño interactivo -->
    <div class="animate__animated animate__zoomIn relative" style="animation-delay:.15s">
      <!-- brillos ambientales -->
      <span class="brillo absolute top-6 left-4 text-2xl text-oro" aria-hidden="true">✦</span>
      <span
        class="brillo absolute right-8 bottom-24 text-lg text-rosa"
        style="animation-delay:1.1s"
        aria-hidden="true">✦</span
      >
      <span
        class="brillo absolute top-24 right-2 text-sm text-lila"
        style="animation-delay:2s"
        aria-hidden="true">✦</span
      >

      <div class="mx-auto max-w-[28rem]">
        <svg
          viewBox="0 0 200 190"
          class="moño-vaiven w-full drop-shadow-[0_28px_36px_rgba(74,42,56,0.22)]"
          role="img"
          aria-labelledby="titulo-mono-hero"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="titulo-mono-hero">Moño de Lissy Moños, color de muestra</title>
          <defs>
            <linearGradient id="degradado-hero" x1="16%" y1="2%" x2="88%" y2="98%">
              <stop offset="0%" stop-color="var(--tono-2)" />
              <stop offset="55%" stop-color="var(--tono)" />
              <stop offset="100%" stop-color="var(--tono)" />
            </linearGradient>
          </defs>

          <path
            d="M95 96 C86 124 72 146 50 164 C62 170 78 168 88 158 C99 138 104 116 106 100 Z"
            fill="url(#degradado-hero)"
          ></path>
          <path
            d="M105 96 C114 124 128 146 150 164 C138 170 122 168 112 158 C101 138 96 116 94 100 Z"
            fill="url(#degradado-hero)"
          ></path>
          <path
            d="M95 96 C86 124 72 146 50 164 C62 170 78 168 88 158 C99 138 104 116 106 100 Z"
            fill="#2C1A22"
            opacity="0.12"></path>

          <path d="M100 92 C72 48 24 44 16 78 C9 110 60 116 100 96 Z" fill="url(#degradado-hero)"></path>
          <path d="M100 92 C128 48 176 44 184 78 C191 110 140 116 100 96 Z" fill="url(#degradado-hero)"></path>
          <path d="M100 92 C74 62 44 58 30 72 C48 66 76 76 100 96 Z" fill="#2C1A22" opacity="0.14"></path>
          <path d="M100 92 C126 62 156 58 170 72 C152 66 124 76 100 96 Z" fill="#2C1A22" opacity="0.14"></path>
          <path d="M34 62 C48 52 66 54 78 64 C64 60 48 58 34 62 Z" fill="#fff" opacity="0.5"></path>

          <ellipse cx="100" cy="94" rx="17" ry="15" fill="var(--tono)"></ellipse>
          <ellipse cx="100" cy="94" rx="17" ry="15" fill="#2C1A22" opacity="0.17"></ellipse>
          <ellipse cx="95" cy="89" rx="6" ry="4.5" fill="#fff" opacity="0.45"></ellipse>
        </svg>
      </div>

      <!-- Selector de tono -->
      <div class="mx-auto mt-6 max-w-[28rem] rounded-petalo bg-white/70 p-5 shadow-suave backdrop-blur-sm">
        <div class="flex items-baseline justify-between gap-4">
          <p class="eyebrow">Pruébalo en</p>
          <p class="font-mono text-xs text-tinta">
            <span data-codigo-tono>{tonosHero[0].codigo}</span>
            <span class="mx-1.5 text-rosa">·</span>
            <span data-nombre-tono>{tonosHero[0].nombre}</span>
          </p>
        </div>
        <div class="mt-4 flex flex-wrap gap-2.5" role="group" aria-label="Elegir color del moño">
          {
            tonosHero.map((tono, i) => (
              <button
                type="button"
                class="h-9 w-9 rounded-full ring-offset-2 ring-offset-white transition hover:scale-110 aria-pressed:ring-2 aria-pressed:ring-tinta"
                style={`background:${tono.hex};box-shadow:inset 0 0 0 1px rgba(44,26,34,.14)`}
                data-tono={tono.hex}
                data-tono-nombre={tono.nombre}
                data-tono-codigo={tono.codigo}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={`${tono.nombre}, código ${tono.codigo}`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes trazo {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const botones = hero?.querySelectorAll<HTMLButtonElement>('[data-tono]');
  const nombres = hero?.querySelectorAll<HTMLElement>('[data-nombre-tono]');
  const codigos = hero?.querySelectorAll<HTMLElement>('[data-codigo-tono]');

  /** Aclara un hex para el segundo stop del degradado. */
  const aclarar = (hex: string, mezcla = 0.55) => {
    const n = parseInt(hex.slice(1), 16);
    const r = (n >> 16) & 255;
    const g = (n >> 8) & 255;
    const b = n & 255;
    const m = (c: number) => Math.round(c + (255 - c) * mezcla);
    return `rgb(${m(r)} ${m(g)} ${m(b)})`;
  };

  botones?.forEach((boton) => {
    boton.addEventListener('click', () => {
      const hex = boton.dataset.tono!;
      hero!.style.setProperty('--tono', hex);
      hero!.style.setProperty('--tono-2', aclarar(hex));
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
      nombres?.forEach((el) => (el.textContent = boton.dataset.tonoNombre!));
      codigos?.forEach((el) => (el.textContent = boton.dataset.tonoCodigo!));
    });
  });
</script>

---
import { categoriaDe, precioEnNumero, rutaProducto, type Producto } from '../data/site';
import Foto from './Foto.astro';
import BotonPedir from './BotonPedir.astro';

/* Tarjeta de una referencia del catálogo.

   No se envuelve toda la tarjeta en un <a>: dentro va el botón de
   WhatsApp y anidar enlaces es inválido. En su lugar el título lleva un
   ::after que cubre la tarjeta, y el botón se levanta con z-10. */

interface Props {
  producto: Producto;
  /** Retraso de la animación de entrada. */
  indice?: number;
  prioridad?: boolean;
}

const { producto: p, indice = 0, prioridad = false } = Astro.props;

const categoria = categoriaDe(p.tipo);
const precio = precioEnNumero(p.precio) ?? 0;

/* Texto sobre el que busca el filtro, sin tildes ni mayúsculas. */
const buscable = [p.nombre, p.ref, p.resumen, categoria.nombre, ...(p.colores ?? []), ...(p.packs ?? [])]
  .join(' ')
  .toLowerCase()
  .normalize('NFD')
  // ̀-ͯ = tildes y diéresis sueltas que deja NFD

  .replace(/[̀-ͯ]/g, '');
---

<li
  class="group relative flex flex-col overflow-hidden rounded-petalo bg-white shadow-suave ring-1 ring-tinta/5 transition duration-500 ease-[var(--ease-cinta)] hover:-translate-y-1.5 hover:shadow-alto"
  data-producto
  data-categoria={p.tipo}
  data-precio={precio}
  data-agotado={p.agotado ? '1' : '0'}
  data-buscar={buscable}
  data-reveal="fadeInUp"
  style={`--retraso:${(indice % 3) * 90}ms`}
>
  <figure class="relative aspect-square shrink-0 overflow-hidden">
    <div class="h-full w-full transition-transform duration-700 ease-[var(--ease-cinta)] group-hover:scale-[1.05]">
      <Foto
        foto={p.foto}
        alt={p.alt}
        tipo={p.tipo}
        tono={p.tono}
        tonoSecundario={p.tonoSecundario}
        uid={p.id}
        foco={p.foco}
        prioridad={prioridad}
      />
    </div>

    {
      p.fotoAlterna && (
        <img
          src={p.fotoAlterna}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          width="800"
          height="800"
          class="absolute inset-0 h-full w-full scale-[1.05] object-cover opacity-0 transition-opacity duration-500 ease-[var(--ease-cinta)] group-hover:opacity-100"
        />
      )
    }

    {
      p.agotado ? (
        <span class="absolute top-4 left-4 rounded-full bg-tinta/85 px-3.5 py-1.5 font-mono text-[0.62rem] tracking-[0.18em] text-crema uppercase backdrop-blur-sm">
          Agotado
        </span>
      ) : (
        p.etiqueta && (
          <span class="absolute top-4 left-4 rounded-full bg-white/90 px-3.5 py-1.5 font-mono text-[0.62rem] tracking-[0.18em] text-rosa-hondo uppercase backdrop-blur-sm">
            {p.etiqueta}
          </span>
        )
      )
    }

    <span class="absolute right-4 bottom-4 rounded-full bg-white/85 px-2.5 py-1 font-mono text-[0.58rem] tracking-[0.12em] text-tinta-suave backdrop-blur-sm">
      {p.ref}
    </span>
  </figure>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-xl leading-tight">
        <a
          href={rutaProducto(p)}
          class="transition-colors after:absolute after:inset-0 hover:text-rosa-hondo"
        >
          {p.nombre}
        </a>
      </h3>
      {
        p.precio && (
          <span class="shrink-0 text-right">
            <span class="block font-display text-lg text-rosa-hondo">{p.precio}</span>
            {p.unidad && (
              <span class="block font-mono text-[0.55rem] tracking-[0.14em] text-tinta-suave/70 uppercase">
                {p.unidad}
              </span>
            )}
          </span>
        )
      }
    </div>

    <p class="mt-2 text-[0.92rem] text-tinta-suave">{p.resumen}</p>

    {
      p.packs && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {p.packs.map((pack) => (
            <li class="rounded-full bg-rubor/70 px-2.5 py-1 text-[0.72rem] text-tinta">{pack}</li>
          ))}
        </ul>
      )
    }

    <BotonPedir producto={p} variante="contorno" class="relative z-10 mt-5 self-start" />
  </div>
</li>

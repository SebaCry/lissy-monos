---
import Layout from '../layouts/Layout.astro';
import Arte from '../components/Arte.astro';
import { marca } from '../data/site';
---

<Layout
  title={`Página no encontrada — ${marca.nombre}`}
  description="Esta página se soltó como un moño mal amarrado. Vuelve al inicio para ver la colección."
  noindex
>
  <main class="papel grid min-h-screen place-items-center px-5 py-24 text-center">
    <div>
      <Arte tipo="mono" tono="#F2789F" tonoSecundario="#FBD3DE" uid="404" class="mx-auto w-32 opacity-80" />
      <p class="eyebrow mt-8">Error 404</p>
      <h1 class="mt-4 text-[clamp(2.2rem,6vw,3.6rem)]">Este moño se soltó</h1>
      <p class="mx-auto mt-5 max-w-md text-lg text-tinta-suave">
        La página que buscas ya no está aquí. Vuelve al inicio y sigue viendo la colección.
      </p>
      <a
        href="/"
        class="mt-9 inline-flex items-center gap-2.5 rounded-full bg-rosa-hondo px-7 py-4 font-medium text-white shadow-alto transition hover:-translate-y-0.5 hover:bg-tinta"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
